# Local development: copy to .env and generate BOTH independent keys below.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32 -- keep this key with your backups; losing it loses messages.
MESSAGE_ENCRYPTION_KEY=
DATABASE_PATH=data/nachklang.sqlite
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Nachklang <nachklang@samuelgesang.de>
SMTP_USER=
SMTP_PASS=
# Only for local Mailpit. Remove this in production.
SMTP_ALLOW_INSECURE=true

# Optional admin alarm channel; runtime secrets only, never GitHub build secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set false after creating your private account to disable further registration.
ALLOW_REGISTRATION=true
