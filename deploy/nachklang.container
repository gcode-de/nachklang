[Unit]
Description=Nachklang web application
After=network-online.target
Wants=network-online.target

[Container]
# Replace DOCKERHUB_USER and pin a tested release tag.
Image=docker.io/DOCKERHUB_USER/nachklang:0.3.1
ContainerName=nachklang
PublishPort=127.0.0.1:3000:3000
Volume=nachklang-data.volume:/data:U
EnvironmentFile=%h/.config/nachklang.env
NoNewPrivileges=true
Notify=healthy
HealthCmd=["node","-e","fetch(\"http://127.0.0.1:3000/api/health\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
